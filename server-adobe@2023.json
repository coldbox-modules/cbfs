{
    "name":"cbfs-adobe@2023",
    "app":{
        "serverHomeDirectory":".engine/adobe2023",
        "cfengine":"adobe@2023"
    },
    "web":{
        "http":{
            "port":"60299"
        },
        "rewrites":{
            "enable":"true"
        },
		"webroot": "test-harness",
		"aliases":{
            "/moduleroot/cbfs":"../",
			"/root":"./test-harness"
        }
    },
    "jvm":{
        "heapSize":"1024",
		"args" : "--add-opens java.base/sun.nio.fs=ALL-UNNAMED"
    },
    "openBrowser":"false",
	"cfconfig": {
		"file" : ".cfconfig.json"
	},
    "scripts" : {
        "onServerInstall":"cfpm install zip,debugger"
    }
}
